# Куда лендинг шлёт заявки. Значения задаются в панели Render
# (Environment), в репозиторий не коммитятся.

# Токен бота от @BotFather. Только сервер видит эту переменную:
# форма отправляет заявку на свой же /api/lead, а не в Telegram напрямую,
# иначе токен уехал бы в браузер каждого посетителя.
TELEGRAM_BOT_TOKEN=

# Куда бот пишет заявку: свой user id или id группы (у групп он с минусом).
TELEGRAM_CHAT_ID=

# Базовый адрес сайта: от него считаются canonical, OG-теги и sitemap.
PUBLIC_SITE_URL=https://mvp-ai-solutions.onrender.com
