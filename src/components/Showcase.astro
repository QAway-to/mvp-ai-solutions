---
import { demos } from '../content/offer';
import Flow from './Flow.astro';
import BotDemo from './demos/BotDemo.astro';
import ContentDemo from './demos/ContentDemo.astro';
import FunnelDemo from './demos/FunnelDemo.astro';
import LeadsDemo from './demos/LeadsDemo.astro';
import ReportDemo from './demos/ReportDemo.astro';
import SyncDemo from './demos/SyncDemo.astro';
import type { DemoId } from '../content/types';

/**
 * «Как это работает»: схема на каждое решение, раскрывается по клику.
 *
 * Свёрнутый вид — только схема: человек пробегает шесть потоков глазами и
 * находит свой, не читая шесть описаний подряд. Подробности и рабочий экран
 * появляются в раскрытом блоке, поэтому секция остаётся высотой в экран.
 *
 * Раскрытие на <details>, как в FAQ: работает без JavaScript и с клавиатуры.
 * Атрибут name делает из блоков аккордеон (открыт один); там, где браузер его
 * ещё не знает, просто откроется несколько — ничего не ломается.
 *
 * Тёмная подложка — единственная на лендинге: отделяет обещание от того,
 * как оно устроено, и не даёт двум белым секциям слиться.
 */
/* Тип карты опирается на то, что все экраны не принимают пропсов. Появится
   первый с Props — ошибка вылезет здесь, а не в том компоненте, где разошлось. */
const views: Record<DemoId, typeof BotDemo> = {
  bot: BotDemo,
  leads: LeadsDemo,
  sync: SyncDemo,
  content: ContentDemo,
  report: ReportDemo,
  funnel: FunnelDemo,
};
---

<section id="examples" class="section bg-brand-dark text-canvas">
  <div class="shell">
    <div class="grid gap-x-10 gap-y-3 lg:grid-cols-[1fr_minmax(0,380px)] lg:items-end">
      <div>
        <p class="t-eyebrow opacity-60">Как это работает</p>
        <h2 class="t-display-xl mt-2">Шесть схем вместо шести презентаций</h2>
      </div>
      <p class="t-body-lg max-w-xl opacity-75">
        Каждое решение — поток из четырёх шагов. Раскройте любой, чтобы увидеть, что
        происходит на каждом шаге и как выглядит рабочий экран. Цифры в схемах условные:
        свои появятся после разбора.
      </p>
    </div>

    <div class="border-hairline mt-7 border-t border-white/15">
      {
        demos.map((demo, index) => {
          const View = views[demo.id];

          return (
            <details class="solution border-b border-white/15" name="solution" open={index === 0}>
              <summary>
                <h3 class="t-display-md pr-10">
                  <span class="t-eyebrow block opacity-60">{demo.tag}</span>
                  {demo.title}
                </h3>

                <span class="marker text-2xl leading-none" aria-hidden="true">
                  +
                </span>

                <div class="mt-4">
                  <Flow nodes={demo.flow} />
                </div>
              </summary>

              <div class="grid items-start gap-4 pb-7 lg:grid-cols-[1fr_minmax(0,300px)]">
                <View />

                <div class="rounded-[12px] bg-white/5 p-5">
                  <p class="text-[14px] opacity-75">{demo.text}</p>

                  <p class="t-eyebrow mt-5 opacity-60">Что происходит на каждом шаге</p>
                  <ol class="mt-3 flex flex-col gap-3 border-t border-white/15 pt-4">
                    {demo.flow.map((node, nodeIndex) => (
                      <li class="text-[14px]">
                        <span class="t-num text-primary-subdued mr-2">0{nodeIndex + 1}</span>
                        <span class="opacity-90">{node.label}.</span>
                        <span class="opacity-70"> {node.detail}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            </details>
          );
        })
      }
    </div>

    <div
      class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-[12px] border border-white/15 px-5 py-4"
    >
      <p class="opacity-75">
        Своя схема под вашу задачу собирается на разборе — вместе с оценкой, что окупится первым.
      </p>
      <a href="#lead" class="btn btn-on-dark">Хочу так же</a>
    </div>
  </div>
</section>

<style>
  summary {
    display: block;
    cursor: pointer;
    list-style: none;
    padding-block: 16px;
  }

  /* Плюс выносится из потока: обёртка-флекс вокруг заголовка нарушала бы
     модель содержимого <summary>, где заголовок должен идти первым. */
  details {
    position: relative;
  }

  /* Стрелку по умолчанию в Safari убирает именно этот селектор. */
  summary::-webkit-details-marker {
    display: none;
  }

  .marker {
    position: absolute;
    top: 20px;
    right: 0;
    color: var(--color-primary-subdued);
    transition: transform 0.15s ease;
  }

  details[open] .marker {
    transform: rotate(45deg);
  }

  summary:focus-visible {
    outline: 2px solid var(--color-primary-subdued);
    outline-offset: 4px;
  }

  /* В печать уходит одна раскрытая схема из шести — для PDF это потеря
     пяти решений, поэтому на печати раскрываются все. */
  @media print {
    details > *:not(summary) {
      display: block !important;
    }

    .marker {
      display: none;
    }
  }
</style>
