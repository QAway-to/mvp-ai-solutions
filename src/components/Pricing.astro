---
import { pricing, pricingNote } from '../content/offer';
---

<section id="pricing" class="bg-canvas-soft section">
  <div class="shell">
    <div class="grid gap-x-10 gap-y-3 lg:grid-cols-[1fr_minmax(0,380px)] lg:items-end">
      <div>
        <p class="t-eyebrow text-ink-mute">Стоимость</p>
        <h2 class="t-display-xl text-ink mt-2">Платите по шагам, а не за обещание</h2>
      </div>
      <p class="t-body-lg text-ink-secondary max-w-xl">
        Каждый следующий шаг начинается, только если предыдущий вас устроил.
        Точная смета называется на разборе — до начала работ.
      </p>
    </div>

    <div class="mt-7 grid items-start gap-4 lg:grid-cols-3">
      {
        pricing.map((tier) => (
          <div class={tier.featured ? 'card-dark flex flex-col' : 'card flex flex-col'}>
            {tier.featured && <p class="t-eyebrow text-primary-subdued">Чаще всего берут</p>}

            <h3 class={`t-heading-lg ${tier.featured ? 'mt-3' : ''}`}>{tier.name}</h3>

            <p class="t-num mt-4 text-4xl font-light">{tier.price}</p>
            <p class={`t-caption mt-2 ${tier.featured ? 'opacity-70' : 'text-ink-mute'}`}>
              {tier.priceNote}
            </p>

            <p class={`mt-4 ${tier.featured ? 'opacity-80' : 'text-ink-mute'}`}>{tier.text}</p>

            <ul
              class={`mt-4 flex flex-col gap-2.5 border-t pt-4 ${
                tier.featured ? 'border-white/15' : 'border-hairline'
              }`}
            >
              {tier.features.map((feature) => (
                <li class="flex gap-2.5 text-[14px]">
                  <span
                    class={`mt-[7px] inline-block h-1.5 w-1.5 shrink-0 rounded-full ${
                      tier.featured ? 'bg-primary-subdued' : 'bg-primary'
                    }`}
                    aria-hidden="true"
                  />
                  <span class={tier.featured ? '' : 'text-ink-secondary'}>{feature}</span>
                </li>
              ))}
            </ul>

            {/* Кнопка прижата к низу, чтобы карточки разной высоты выравнивались. */}
            <div class="mt-auto pt-6">
              <a
                href="#lead"
                class={`btn w-full ${tier.featured ? 'btn-on-dark' : 'btn-secondary'}`}
              >
                {tier.cta}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="t-caption text-ink-mute mt-5 max-w-3xl">{pricingNote}</p>
  </div>
</section>
