---
/**
 * Градиентный меш — фирменная подложка верхней трети страницы.
 *
 * Почему SVG, а не CSS-градиент: у настоящего меша пятна органической формы,
 * плоский linear-gradient даёт полосы и читается дёшево. Пятна размываются
 * фильтром прямо в SVG, поэтому картинка весит пару килобайт и не тянет
 * ни одного запроса — важно, страница живёт на платном трафике.
 *
 * Цвета — только документированные остановки меша: крем, шербет, лаванда,
 * индиго, рубин, маджента. Новые оттенки сюда добавлять нельзя.
 */
interface Props {
  /** Дополнительные классы позиционирования от родителя. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={`pointer-events-none select-none ${className}`}
  viewBox="0 0 1440 620"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id="mesh-blur" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="90" />
    </filter>
    <linearGradient id="mesh-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="white" stop-opacity="0.45" />
      <stop offset="14%" stop-color="white" stop-opacity="0.08" />
      <stop offset="55%" stop-color="white" stop-opacity="0.35" />
      <stop offset="100%" stop-color="white" stop-opacity="1" />
    </linearGradient>
  </defs>

  <rect width="1440" height="620" fill="#f5e9d4" />

  <g filter="url(#mesh-blur)">
    <ellipse cx="140" cy="90" rx="380" ry="240" fill="#f5e9d4" />
    <ellipse cx="430" cy="180" rx="330" ry="230" fill="#f9a03c" opacity="0.75" />
    <ellipse cx="760" cy="60" rx="360" ry="250" fill="#f96bee" opacity="0.55" />
    <ellipse cx="980" cy="230" rx="340" ry="260" fill="#b9b9f9" />
    <ellipse cx="1320" cy="230" rx="320" ry="250" fill="#533afd" opacity="0.6" />
    <ellipse cx="1180" cy="380" rx="300" ry="200" fill="#ea2261" opacity="0.45" />
    <ellipse cx="620" cy="430" rx="420" ry="220" fill="#b9b9f9" opacity="0.9" />
  </g>

  <!-- Меш растворяется в белом холсте, иначе на стыке видна жёсткая граница. -->
  <rect width="1440" height="620" fill="url(#mesh-fade)" />
</svg>
