---
import { testimonials } from '../content/offer';

/**
 * Секция появляется только когда в offer.ts добавлены настоящие отзывы.
 * Пустой массив по умолчанию — сознательно: лучше отсутствие блока,
 * чем выдуманные цитаты на странице, которая принимает платный трафик.
 */
---

{
  testimonials.length > 0 && (
    <section class="section">
      <div class="shell">
        <p class="t-eyebrow text-ink-mute">Отзывы</p>
        <h2 class="t-display-xl text-ink mt-3 max-w-3xl">Что говорят после внедрения</h2>

        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((item) => (
            <figure class="card flex flex-col">
              <blockquote class="t-body-lg text-ink-secondary">{item.text}</blockquote>
              <figcaption class="border-hairline mt-auto border-t pt-5">
                <p class="text-ink">{item.name}</p>
                <p class="t-caption text-ink-mute mt-1">{item.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
