---
/**
 * Композит из фальшивого продуктового интерфейса — приём дизайн-системы:
 * вместо фотостока и абстрактных «нейросетей» показывается то, чем человек
 * будет пользоваться. Слева диалог бота, в центре таблица заявок, справа сводка.
 *
 * Панели свёрстаны разметкой, а не картинкой: текст остаётся текстом, ничего
 * не размывается на ретине и не тянет лишний запрос. На мобильном боковые
 * панели скрываются — по системе композит там сворачивается до одной.
 *
 * Стили панелей живут в global.css: те же поверхности рисует секция
 * «Как это выглядит», и копия здесь со временем разъехалась бы с ней.
 *
 * Цифры здесь — иллюстрация интерфейса, а не результаты клиентов, поэтому
 * они намеренно нейтральные. Не переносить их в текст лендинга как обещания.
 */
const dialog = [
  { from: 'client', text: 'Здравствуйте! Доставка в регионы есть?' },
  { from: 'bot', text: 'Да, доставляем — 2–3 дня. Подсказать по наличию?' },
  { from: 'client', text: 'Нужно 20 штук на склад' },
  { from: 'bot', text: 'Это опт — передаю менеджеру, он ответит в течение часа.' },
  { from: 'client', text: 'Отлично, жду' },
];

const rows = [
  { source: 'Telegram', task: 'Опт, 20 шт', status: 'Менеджеру', amount: '38 000' },
  { source: 'Сайт', task: 'Расчёт стоимости', status: 'Отвечено', amount: '4 500' },
  { source: 'WhatsApp', task: 'Статус заказа', status: 'Закрыто', amount: '—' },
  { source: 'Telegram', task: 'Реквизиты', status: 'Закрыто', amount: '—' },
  { source: 'Сайт', task: 'Подбор модели', status: 'Отвечено', amount: '12 900' },
  { source: 'WhatsApp', task: 'Возврат', status: 'Менеджеру', amount: '—' },
];
---

<div class="grid gap-4 lg:grid-cols-12">
  <!-- Диалог: единственная панель, которая остаётся на мобильном. -->
  <div class="panel lg:col-span-4">
    <div class="panel-head">
      <span class="panel-dot bg-primary"></span>
      Бот поддержки
    </div>

    <div class="flex flex-col gap-2 p-4">
      {
        dialog.map((line) => (
          <p class={`bubble ${line.from === 'bot' ? 'bubble-bot' : 'bubble-client'}`}>
            {line.text}
          </p>
        ))
      }
    </div>
  </div>

  <div class="panel hidden lg:col-span-5 lg:block">
    <div class="panel-head">
      <span class="panel-dot bg-ruby"></span>
      Заявки за сегодня
    </div>

    <table class="w-full">
      <thead>
        <tr class="text-ink-mute">
          <th class="panel-cell text-left font-normal">Канал</th>
          <th class="panel-cell text-left font-normal">Запрос</th>
          <th class="panel-cell text-left font-normal">Статус</th>
          <th class="panel-cell text-right font-normal">Сумма</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-hairline border-t">
              <td class="panel-cell">{row.source}</td>
              <td class="panel-cell">{row.task}</td>
              <td class="panel-cell">
                <span class="panel-status">{row.status}</span>
              </td>
              <td class="panel-cell t-num text-right">{row.amount}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="hidden flex-col gap-4 lg:col-span-3 lg:flex">
    <div class="panel flex-1 p-5">
      <p class="t-eyebrow text-ink-mute">Обработано ботом</p>
      <p class="t-num text-ink mt-2 text-4xl font-light">82%</p>
      <p class="t-caption text-ink-mute mt-1">без участия менеджера</p>

      <div class="mt-5 flex h-16 items-end gap-1.5" aria-hidden="true">
        <span class="bar" style="height: 38%"></span>
        <span class="bar" style="height: 52%"></span>
        <span class="bar" style="height: 45%"></span>
        <span class="bar" style="height: 68%"></span>
        <span class="bar" style="height: 74%"></span>
        <span class="bar bar-strong" style="height: 92%"></span>
      </div>
    </div>

    <div class="card-dark p-5">
      <p class="t-eyebrow opacity-70">Среднее время ответа</p>
      <p class="t-num mt-2 text-4xl font-light">4 сек</p>
      <p class="t-caption mt-1 opacity-70">круглосуточно</p>
    </div>
  </div>
</div>

