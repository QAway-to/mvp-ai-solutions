---
import { processSteps } from '../content/offer';
---

<section id="process" class="bg-canvas-soft section">
  <div class="shell">
    <p class="t-eyebrow text-ink-mute">Как работаем</p>
    <h2 class="t-display-xl text-ink mt-3 max-w-3xl">
      От разговора до работающего решения — четыре шага
    </h2>

    <ol class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        processSteps.map((step) => (
          <li class="card flex flex-col">
            <div class="flex items-baseline justify-between gap-3">
              <span class="t-num text-primary text-3xl font-light">{step.no}</span>
              <span class="t-caption text-ink-mute">{step.duration}</span>
            </div>

            <h3 class="t-heading-lg text-ink mt-5">{step.title}</h3>
            <p class="text-ink-mute mt-3">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
