---
import { faq } from '../content/offer';

/**
 * Аккордеон на <details>: раскрытие работает без единой строки JavaScript
 * и остаётся доступным с клавиатуры и для скринридера.
 */
---

<section id="faq" class="section">
  <!-- Заголовок отдельной колонкой: вопросы узкие по природе, и в одну колонку
       секция растягивалась вниз, оставляя половину ширины пустой. -->
  <div class="shell grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,300px)_1fr]">
    <div>
      <p class="t-eyebrow text-ink-mute">Вопросы</p>
      <h2 class="t-display-xl text-ink mt-2">То, что спрашивают до разбора</h2>
    </div>

    <div class="border-hairline border-t">
      {
        faq.map((item) => (
          <details class="border-hairline group border-b">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4">
              <span class="t-heading-sm text-ink">{item.q}</span>
              <span class="marker text-primary shrink-0 text-2xl leading-none" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="text-ink-mute max-w-2xl pb-5">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Стрелку по умолчанию в Safari убирает именно этот селектор. */
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] .marker {
    transform: rotate(45deg);
  }

  .marker {
    transition: transform 0.15s ease;
  }
</style>
